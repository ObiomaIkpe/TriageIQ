# Cloudflare Turnstile SITE key for the public contact form (the page at "/").
# This is Cloudflare's documented TEST site key: it always passes, and it only works with the matching test SECRET
# (1x0000000000000000000000000000000AA) in gateway/.env. Never put a real secret here; a real SITE key is public by
# design but still comes from the deployment, not from git (M6).
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
