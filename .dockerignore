# Keeps the build context small and secrets out of the image.
# The Dockerfile only copies requirements.txt, app/, alembic.ini and alembic/,
# so none of those may be listed here (tests/test_dockerfile.py checks that).
.git
.env
.env.*
venv/
.pytest_cache/
**/__pycache__
**/*.pyc
tests/
*.sql
gateway/
# Nothing but app/, alembic/, alembic.ini and requirements.txt is copied by the Dockerfile; the rest need not even be sent.
# The three patterns below keep an env file out of the build context wherever it sits (deploy/env/*.env, gateway/.env, web/.env).
**/.env
**/.env.*
**/*.env
deploy/
web/
db/
scripts/
evals/
