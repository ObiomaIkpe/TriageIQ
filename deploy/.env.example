# Read by docker compose automatically (this file sits next to docker-compose.prod.yml). Copy to deploy/.env.
# The image tag to run: "sha-<7 characters of the commit>" (exact, recommended) or "main" (the newest). Update = change it, then
# `docker compose -f docker-compose.prod.yml pull && docker compose -f docker-compose.prod.yml up -d`. See README.
TAG=main
# The GitHub account or organisation that owns the images (lower case): ghcr.io/<owner>/triageiq-app etc.
GHCR_OWNER=obiomaikpe
