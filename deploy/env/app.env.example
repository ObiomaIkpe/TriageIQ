# The Python service (app). Copy to app.env. make-secrets fills REVIEW_API_KEY and the password in DATABASE_URL.
# YOU fill the two provider keys by hand (they come from your Anthropic and Voyage accounts).
APP_ENV=production
LOG_LEVEL=INFO

ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY
VOYAGE_API_KEY=REPLACE_ME_VOYAGE_API_KEY

# The same value as TRIAGE_REVIEW_API_KEY in gateway.env (make-secrets writes both).
REVIEW_API_KEY=REPLACE_ME_REVIEW_API_KEY

# The least-privilege role triageiq_app, never the superuser. Host "db" is the db service on the internal network.
DATABASE_URL=postgresql://triageiq_app:REPLACE_ME_APP_DB_PASSWORD@db:5432/triageiq

# Tracing is off. (Turn it on only with a LangSmith key: tickets and customer text would be sent there.)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional tuning, defaults shown:
# MODEL_ID=claude-sonnet-4-6
# VOYAGE_RPM=3
# LLM_MAX_TOKENS=700
