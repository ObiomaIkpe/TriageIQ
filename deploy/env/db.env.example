# Postgres (db service). Copy to db.env, then run ./make-secrets.sh to fill the passwords (it never prints them).
# This file holds the SUPERUSER password. Nothing else gets it: the app and the gateway use their own, limited roles.
POSTGRES_USER=triageiq_admin
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_DB=triageiq
# The gateway's role (database "gateway") and the Python service's role triageiq_app (database "triageiq").
# The same values appear inside GATEWAY_DATABASE_URL (gateway.env) and DATABASE_URL (app.env): make-secrets keeps them in step.
GATEWAY_DB_PASSWORD=REPLACE_ME_GATEWAY_DB_PASSWORD
TRIAGEIQ_APP_DB_PASSWORD=REPLACE_ME_APP_DB_PASSWORD
